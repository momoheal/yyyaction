{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:en": "vite build --mode english --outDir dist-en",
    "build:minigame": "vite build --config vite.minigame.config.ts",
    "build:minigame-opt": "node minigame-opt/build.mjs",
    "test:minigame-opt": "node minigame-opt/smoke-test.mjs",
    "build:optimized": "node optimized/scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "art:props": "node art_assets/build-gallery.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
